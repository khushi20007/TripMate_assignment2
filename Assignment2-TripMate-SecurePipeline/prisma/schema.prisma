generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  role          String        @default("member")
  banned        Boolean       @default(false)
  createdAt     DateTime
  updatedAt     DateTime

  sessions     Session[]
  accounts     Account[]
  transactions Transaction[]
  auditLogs    AuditLog[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String    @db.Text
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
}

model Role {
  id          String   @id
  name        String   @unique
  description String?
  createdAt   DateTime
}

model Transaction {
  id          String        @id
  userId      String
  type        String
  amount      Decimal       @db.Decimal(10, 2)
  status      String
  reference   String        @unique
  metadata    Json?
  createdAt   DateTime
  updatedAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  auditLogs   AuditLog[]
  emailEvents EmailEvent[]

  @@index([userId])
  @@index([status])
}

model AuditLog {
  id            String       @id
  userId        String
  transactionId String?
  action        String
  details       Json?
  createdAt     DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([transactionId])
}

model EmailEvent {
  id            String       @id
  resendEventId String?      @unique
  transactionId String?
  type          String
  recipient     String?
  payload       Json?
  receivedAt    DateTime

  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([type])
}
